# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# List current models with: python scripts/list_models.py
GROQ_MODEL=openai/gpt-oss-120b
# "embedded" = mock PolicyCenter runs inside the app. Or point to a separate server:
# POLICYCENTER_URL=http://127.0.0.1:8001   (start it with: uvicorn mock_policycenter.api:app --port 8001)
POLICYCENTER_URL=embedded
# Set to false to skip the OpenStreetMap geocoding call (e.g. offline)
ENABLE_GEOCODING=true
